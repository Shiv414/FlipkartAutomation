<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework> <!-- Adjust for .NET Core 3.1/6.0/etc. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable> <!-- Prevents publishing as a NuGet package -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Package References -->
    <PackageReference Include="Selenium.WebDriver" Version="4.16.2" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="AventStack.ExtentReports" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure config/testdata files are copied to output -->
    <None Update="TestData\TestData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
